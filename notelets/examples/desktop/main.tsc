G:puts "Desktop inspector — press any key or :notelet refresh to update.";
G:puts "";
G:puts "Outputs:";
const outputs = notelet:context "outputs";
G:puts outputs;
G:puts "";
G:puts "Graphical cursors:";
const cursors = notelet:context "cursors";
G:puts cursors;
G:puts "";
const output = notelet:context "output";
const workspace = notelet:context "workspace";
const cell = notelet:context "cell";
G:puts output;
G:puts workspace;
G:puts cell;
const columns = notelet:context "columns";
const rows = notelet:context "rows";
G:puts "Cell columns / rows:";
G:puts columns;
G:puts rows;
