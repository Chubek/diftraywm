/* Shared field names for the YAML schema and configuration adapter. */
CONFIG_FIELD(border_size)
CONFIG_FIELD(command_bar_height)
CONFIG_FIELD(status_bar_height)
CONFIG_FIELD(launcher_bar_height)
CONFIG_FIELD(border_color)
CONFIG_FIELD(background_color)
CONFIG_FIELD(command_bar_color)
CONFIG_FIELD(launcher_bar_color)
CONFIG_FIELD(shell)
CONFIG_FIELD(font)
CONFIG_FIELD(font_size)
CONFIG_FIELD(font_ligatures)
CONFIG_FIELD(ncursor_mode)
CONFIG_FIELD(gcursor_mode)
CONFIG_FIELD(word_pool)
CONFIG_FIELD(theme)
CONFIG_FIELD(help_path)
/* The keymap INI file. Every other key-related setting (the Meta prefix chord,
   the built-in bindings, the help pager keys) is read from that file rather
   than from here, so the config keeps a single pointer to the keys. */
CONFIG_FIELD(keymap)
CONFIG_FIELD(launcher_locked)
