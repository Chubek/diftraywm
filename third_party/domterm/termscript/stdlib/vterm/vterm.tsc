# vterm.tsc -- Termscript companion for std.vterm.
#
# Binds the module and the escape sequences a terminal script reaches for most
# often.  Naming the byte sequences once keeps the \x1b values out of the rest
# of a script, and the \xHH escape is what makes them writable at all: without
# it a Termscript string could not contain an ESC byte.
const vterm_m = G:load "std.vterm" or G:die "std.vterm missing";

const vterm_bel = "\x07";
const vterm_esc = "\x1b";
const vterm_csi = "\x1b[";
const vterm_st = "\x1b\\";

# Grid motions and erases.
const vterm_home = "\x1b[H";
const vterm_clear = "\x1b[2J";
const vterm_clear_line = "\x1b[2K";

# SGR.
const vterm_sgr_reset = "\x1b[0m";
const vterm_bold = "\x1b[1m";
const vterm_underline = "\x1b[4m";
const vterm_reverse = "\x1b[7m";

# The alternate screen, entered and left as a matched pair.
const vterm_alt_on = "\x1b[?1049h";
const vterm_alt_off = "\x1b[?1049l";

# OSC title setting, without its terminator.
const vterm_title = "\x1b]0;";

# Terminal reports the grid can be asked to produce through `reply`.
const vterm_dsr_cursor = "\x1b[6n";
const vterm_dsr_status = "\x1b[5n";
const vterm_device_attributes = "\x1b[c";
