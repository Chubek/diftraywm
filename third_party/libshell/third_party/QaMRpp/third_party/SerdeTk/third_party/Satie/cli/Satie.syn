# Satie REPL / DSL syntax definition.
# Format: one rule per line,  <class> = <regex>
# The REPL walks the buffer, applies the first matching class at each
# position, and emits the ANSI color bound to that class (see palette).
# Regexes use the RE2/ECMAScript subset understood by Satie's tokenizer.

# --- palette (name = SGR code) ---
@color comment  = 90   # bright black (gray)
@color keyword  = 36   # cyan
@color operator = 33   # yellow
@color literal  = 32   # green
@color negate   = 31   # red
@color number   = 35   # magenta
@color variable = 37   # white
@color paren    = 34   # blue
@color string   = 32   # green

# --- token classes (order matters; first match wins) ---

# DIMACS / REPL keywords
keyword = \b(p|cnf|SAT|UNSAT|sat|unsat|solve|load|engine|help|quit|exit|status|model|count|dpll|cdcl|native|reset|vars|show)\b

# line comments: DIMACS 'c ...' and shell '# ...'
comment = ^c\b.*
comment = \#.*

# negation prefix
negate = [~!]

# clause operators
operator = [&|]
operator = \^      # xor / alt-and
operator = v       # disjunction shorthand

# DIMACS terminator / zero
number = \b0\b
number = [0-9]+

# parenthesisation
paren = [()]

# identifiers (DSL variables)
variable = [A-Za-z_][A-Za-z0-9_]*

# quoted strings (file paths)
string = "[^"]*"
